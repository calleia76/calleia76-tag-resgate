# Backend
PORT=4001
NODE_ENV=development
FRONTEND_URL=http://localhost:5174

# Banco — SQLite local por padrão (zero configuração). Para trocar por Postgres (ex.: um
# projeto Supabase próprio, só desta aplicação), troque o provider em prisma/schema.prisma
# para "postgresql" e aponte DATABASE_URL para a connection string do Postgres.
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=troque-por-um-segredo-forte-antes-de-ir-para-producao
JWT_EXPIRES_IN=8h

# Envio do código de "esqueci minha senha". Sem isso configurado, o código só aparece no
# console/log do backend (modo desenvolvimento) — ver src/modules/auth/notificador.ts.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TAG Resgate <nao-responda@exemplo.com>"
