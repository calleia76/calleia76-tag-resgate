# Backend
PORT=4001
NODE_ENV=development
FRONTEND_URL=http://localhost:5174

# Banco — Postgres. Local: `docker compose up -d` (ver docker-compose.yml). Em produção, aponte
# para um Postgres próprio, só desta aplicação.
DATABASE_URL="postgresql://tagresgate:tagresgate@localhost:5433/tagresgate"
# Usada pelas migrations. Localmente é a mesma; no Supabase é a string do "session pooler"
# (DATABASE_URL = "transaction pooler" com ?pgbouncer=true).
DIRECT_URL="postgresql://tagresgate:tagresgate@localhost:5433/tagresgate"

# Auth
JWT_SECRET=troque-por-um-segredo-forte-antes-de-ir-para-producao
JWT_EXPIRES_IN=8h

# Envio do código de "esqueci minha senha". Sem isso configurado, o código só aparece no
# console/log do backend (modo desenvolvimento) — ver src/modules/auth/notificador.ts.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TAG Resgate <nao-responda@exemplo.com>"

# Fotos — pasta em disco onde ficam os uploads (servida em /uploads). Em produção aponte para um
# volume persistente fora da pasta de deploy. Padrão: apps/backend/uploads.
UPLOADS_DIR=

# Trava de teste (opcional): "usuario:senha". Enquanto definida, o site inteiro pede login HTTP
# básico e não é indexado — use para testar em produção antes de abrir ao público.
BETA_ACESSO=
