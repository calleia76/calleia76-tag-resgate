// Banco próprio da TAG Resgate — independente do SAER. Postgres: local via `docker compose up -d`
// (ver docker-compose.yml) e, em produção, um Postgres próprio apontado por DATABASE_URL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // conexão direta/sessão, usada pelas migrations (pooler em modo transação não serve)
}

// Um único modelo: conta de acesso (e-mail/senha) + ficha de saúde/emergência, já que aqui não
// existe um "Cadastro Funcional" externo para vincular (cadastro livre, qualquer pessoa).
model Usuario {
  id        String @id @default(cuid())

  // Identificação
  nome          String
  identificador String? // documento/matrícula livre — opcional, sem validação externa
  cargo         String?
  organizacao   String?
  foto          String? // caminho público do arquivo em /uploads

  // Acesso
  email    String  @unique
  senhaHash String
  ativo    Boolean @default(true)

  // Ficha de saúde/emergência — mesmos campos da ficha pública
  tipoSanguineo          String?
  planoSaude             String?
  operadoraSaude         String?
  numeroCarteirinha      String?
  condicaoSaude          String?
  telefoneEmergencia     String?
  contatoEmergencia      String?
  medicamentosContinuo   String?
  descricaoMedicamentos  String?
  alergiasConhecidas     String?
  descricaoAlergia       String?
  observacoesMedicas     String?

  // Grupos de campo marcados como privados — JSON stringificado de string[] (ver
  // src/modules/ficha/campos-visibilidade.ts). Regra geral: lista vazia = tudo público.
  camposPrivados String @default("[]")

  // Token opaco da própria tag (QR/NFC) — gerado automaticamente no cadastro
  emergenciaToken String @unique

  // "Esqueci minha senha"
  resetCodigoHash String?
  resetExpiraEm   DateTime?

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  ultimoLoginEm DateTime?
}
